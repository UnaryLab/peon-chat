[Unit]
Description=peon-chat multi-agent Slack bots
After=network-online.target

[Service]
# Adjust WorkingDirectory, the conda path in ExecStart, and the log path in StandardOutput for your machine.
WorkingDirectory=%h/Projects/peon-chat
# Runtime config (OBSIDIAN_VAULT_PATH, secrets, timeouts, toggles) lives in
# .env at WorkingDirectory; peon-chat loads it first and the CLI subprocess inherits
# it. Add Environment=/EnvironmentFile= here only for vars needed before .env.
# Linux laptop variant: uncomment this ExecStart to block system sleep and
# lid-close suspend while peon-chat is running long surveys. `systemd-inhibit` is
# Linux-only; macOS uses deploy/com.unarylab.peon-chat.plist with caffeinate.
# ExecStart=/usr/bin/systemd-inhibit --what=sleep:handle-lid-switch --why="peon-chat long-running surveys" --mode=block /usr/bin/env conda run --no-capture-output -n peon-chat python -m src
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env conda run --no-capture-output -n peon-chat python -m src
StandardOutput=append:%h/Projects/peon-chat/peon-chat.log
StandardError=inherit
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
# Wait 30s between relaunches so a crash into a still-broken network does not
# hot-loop (the launchd ThrottleInterval analog). Linux servers do not
# maintenance-sleep, so there is no caffeinate equivalent here.
RestartSec=30

[Install]
WantedBy=default.target
